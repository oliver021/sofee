{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "sofee-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--workspace=@sofee/web"],
      "port": 5173
    },
    {
      "name": "sofee-api",
      "runtimeExecutable": "bash",
      "runtimeArgs": ["-lc", "cd apps/api && uv run uvicorn app.main:app --port 8000 --reload"],
      "port": 8000
    },
    {
      "name": "sofee-admin",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--workspace=@sofee/admin"],
      "port": 5174
    }
  ]
}
