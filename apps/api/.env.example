# Copiar a .env y ajustar. Todos son opcionales en desarrollo.

DATABASE_URL=postgresql+asyncpg://sofee:sofee@localhost:5432/sofee

SESSION_COOKIE_NAME=sofee_session
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_DOMAIN=
# TTL de sesión con sliding expiration (segundos). 30 días por defecto.
SESSION_TTL_SECONDS=2592000
CSRF_SECRET=dev-csrf-secret-change-me

# Lista JSON de orígenes permitidos (CORS). Vacío = mismo origen (admin/web en mismo dominio).
CORS_ALLOWED_ORIGINS=[]
# Lista JSON de IPs de proxy autorizadas a introducir X-Forwarded-For (para rate
# limit y auditoría). Vacío = se usa siempre la IP del socket directo.
TRUSTED_PROXIES=[]

# M7: rate limiting de /auth/login. Máximo de fallos por email y por IP en la
# ventana (segundos). Transcurrida la ventana sin exceder el límite se reinicia.
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900

# M2: clave maestra Fernet para cifrar API keys de providers.
SECRET_ENCRYPTION_KEY=

# M4: almacenamiento. `local` escribe bajo STORAGE_LOCAL_DIR; `s3` aún no
# implementado (pendiente de M7).
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=./storage
# Límite de subida por archivo (bytes). 25 MB por defecto.
STORAGE_MAX_UPLOAD_BYTES=26214400

# M7: despliegue. Ruta al dist de apps/admin servido en /admin (por defecto se
# resuelve relativa al código). CONTENT_SECURITY_POLICY anula la CSP por defecto;
# va vacía se deja seteada a la CSP estándar del panel.
ADMIN_DIST_DIR=
CONTENT_SECURITY_POLICY=
# RAG sobre la base de conocimiento. Sin las dos primeras, el agente busca solo con full-text.
# Cualquier API compatible con OpenAI (p. ej. llama-server --embeddings) o un proveedor remoto.
# Tras cambiar de modelo: `uv run python -m app.cli reindex-kb`.
EMBEDDINGS_BASE_URL=
EMBEDDINGS_MODEL=
EMBEDDINGS_API_KEY=
# Prefijo de las consultas (no de los documentos). Qwen3-Embedding lo necesita:
# EMBEDDINGS_QUERY_PREFIX="Instruct: Given a question, retrieve the passages that answer it\nQuery: "
